{
  "manifest_version": 3,
  "name": "Chatterino9 Whispers",
  "version": "1.1.1",
  "description": "Copies the whispers you send on twitch.tv into Chatterino9's Whispers window. Nothing leaves this PC.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage", "alarms", "webRequest"],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://www.twitch.tv/*",
    "https://dashboard.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Chatterino9 Whispers",
    "default_popup": "popup.html"
  }
}
